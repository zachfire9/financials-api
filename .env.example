# Copy this file to .env for local-only overrides.
# Process environment variables take precedence over values in .env.

# Go http.Server bind/listen address. Keep public docs generic; do not commit LAN IPs/hostnames.
FINANCIALS_API_ADDR=:8080

# Storage driver options:
# - memory: process-local in-memory data, resets when the API restarts
# - ephemeral: explicit non-durable in-memory mode for stateless/request-supplied projection workflows
# - json: persists local fake/test data to FINANCIALS_STORAGE_PATH
FINANCIALS_STORAGE_DRIVER=memory

# Required only when FINANCIALS_STORAGE_DRIVER=json.
# /data is gitignored; keep real local paths and private data out of git.
FINANCIALS_STORAGE_PATH=./data/financial-items.json

# Comma-separated browser origins allowed to call the API directly from a static-hosted UI.
# Leave blank for the local Vite proxy workflow. Use placeholder origins in committed docs.
FINANCIALS_ALLOWED_ORIGINS=

# Optional shared access token for deployed personal-use API requests.
# When set, non-health API requests must include X-Financials-Access-Token.
# Keep real tokens in local env files, shell variables, or private deploy parameters only.
FINANCIALS_ACCESS_TOKEN=
